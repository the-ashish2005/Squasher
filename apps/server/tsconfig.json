{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@squasher/agent": ["../../packages/agent/src/index.ts"],
      "@squasher/core": ["../../packages/core/src/index.js"],
      "@squasher/github-mcp": ["../github-mcp/src/index.ts"],
      "@squasher/github": ["../../packages/github/src/index.js"],
      "@squasher/harness": ["../../packages/harness/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/agent" },
    { "path": "../github-mcp" },
    { "path": "../../packages/harness" },
    { "path": "../../packages/core" },
    { "path": "../../packages/github" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "test"]
}
