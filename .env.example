# Local server
PORT=8787
DATA_DIR=.data-local
APP_BASE_URL=http://127.0.0.1:8787
APPROVAL_TOKEN=replace-with-a-random-local-token
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# Local dashboard. The pre-rename BYTER_* spelling of every SQUASHER_* variable below is
# still accepted, so an existing .env keeps working; SQUASHER_* wins when both are set.
SQUASHER_API_TARGET=http://127.0.0.1:8787
VITE_SQUASHER_API_URL=

# Live GitHub intake
GITHUB_TOKEN=
SQUASHER_REQUIRE_TRIGGER_LABEL=true
SQUASHER_TRIGGER_LABEL=squasher:run

# Contribution mode: how a VERIFIED patch is submitted. None of these change the engineering
# work: every mode reads the issue and its discussion, implements, tests and verifies the same
# way. A contribution that cannot happen never turns a verified run into a failed one; the page
# reports "Implementation verified. Pull request not created." with the exact reason.
#   fork   - the default. Push access means a pull request straight to the repository; without
#            it the branch goes to your fork, for repositories in SQUASHER_UPSTREAM_ALLOWLIST
#   own    - only repositories GITHUB_TOKEN can push to receive a pull request
#   triage - never submit automatically; the verified patch is kept
# Fork contributions need a classic PAT with public_repo: fine-grained tokens and GitHub App
# installation tokens cannot create forks. Every GitHub write still waits for a maintainer's
# approval.
SQUASHER_CONTRIBUTION_MODE=fork

# Repositories authorised to receive an automatic fork-based pull request, comma separated as
# owner/repo. This gates the GitHub write only: a repository that is not listed is still worked
# on and verified, and its patch is kept. Empty means no foreign repository is eligible.
# Before adding one, read its CONTRIBUTING.md: Squasher also scans for an explicit refusal of
# automated contributions and blocks the write, but that scan is a keyword check and a clean
# result is not evidence that the project welcomes machine-generated pull requests.
SQUASHER_UPSTREAM_ALLOWLIST=

# Optional cap on how many of your Squasher pull requests may be open on one repository at
# once. Unset means no repository-wide cap: duplicates are prevented per issue instead, so an
# open pull request for #42 never blocks a separate fix for #43, while a second pull request
# for #42 is always refused. Set it if you want the old courtesy limit (for example 1) on
# repositories whose maintainers did not ask for these contributions. Anything other than a
# positive whole number is treated as unset.
SQUASHER_MAX_OPEN_PULL_REQUESTS=

# Model round trips one run may take before it is abandoned. This is the runaway-loop
# guard, so it stays finite. Raise it for large repositories: a live run on one exhausted 64
# while making steady, non-repeating progress. A run that is looping repeats the same calls
# and is obvious in the trace; that is the case this limit is for. Anything other than a
# positive whole number falls back to the default.
SQUASHER_ITERATION_LIMIT=120

# Model (OpenAI-compatible; point DEEPSEEK_BASE_URL elsewhere to switch providers)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=deepseek

# Sandbox execution
E2B_API_KEY=

# Optional: standalone GitHub MCP endpoint at /mcp (not used by the harness,
# which calls the GitHub tool logic in-process)
MCP_AUTH_TOKEN=
