# Local server
PORT=8787
DATA_DIR=.data-local
APP_BASE_URL=http://127.0.0.1:8787
APPROVAL_TOKEN=replace-with-a-random-local-token
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# Local dashboard
BYTER_API_TARGET=http://127.0.0.1:8787
VITE_BYTER_API_URL=

# Live GitHub intake
GITHUB_TOKEN=
BYTER_REQUIRE_TRIGGER_LABEL=true
BYTER_TRIGGER_LABEL=byter:run

# Contribution mode: how a run may write back to the issue's repository.
#   own    - only repositories GITHUB_TOKEN can push to (default)
#   fork   - repositories without push access get a fork-based pull request,
#            but only those named in BYTER_UPSTREAM_ALLOWLIST below
#   triage - never write to GitHub; evidence stays local
# Fork mode needs a classic PAT with public_repo: fine-grained tokens and GitHub App
# installation tokens cannot create forks.
BYTER_CONTRIBUTION_MODE=own

# Repositories eligible for a fork-based pull request, comma separated as owner/repo.
# Empty means no foreign repository is eligible, whatever BYTER_CONTRIBUTION_MODE says.
# Before adding one, read its CONTRIBUTING.md: Byter also scans for an explicit refusal of
# automated contributions and blocks the write, but that scan is a keyword check and a clean
# result is not evidence that the project welcomes machine-generated pull requests.
BYTER_UPSTREAM_ALLOWLIST=

# Model (OpenAI-compatible; point DEEPSEEK_BASE_URL elsewhere to switch providers)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=deepseek

# Sandbox execution
E2B_API_KEY=

# Optional: standalone GitHub MCP endpoint at /mcp (not used by the harness,
# which calls the GitHub tool logic in-process)
MCP_AUTH_TOKEN=
