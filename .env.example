# Local server
PORT=8787
DATA_DIR=.data-local
APP_BASE_URL=http://127.0.0.1:8787
APPROVAL_TOKEN=replace-with-a-random-local-token
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# Local dashboard
BYTER_API_TARGET=http://127.0.0.1:8787
VITE_BYTER_API_URL=

# Live GitHub intake
GITHUB_TOKEN=
BYTER_REQUIRE_TRIGGER_LABEL=true
BYTER_TRIGGER_LABEL=byter:run

# TrueForge and remote GitHub MCP
TRUEFORGE_URL=
TRUEFORGE_API_KEY=
TRUEFORGE_MCP_SERVER_NAME=byter-github
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-sol
OPENAI_API_KEY=
MCP_AUTH_TOKEN=
