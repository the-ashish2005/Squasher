# Local server
PORT=8787
DATA_DIR=.data-local
APP_BASE_URL=http://127.0.0.1:8787
APPROVAL_TOKEN=replace-with-a-random-local-token
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# Local dashboard. The pre-rename BYTER_* spelling of every SQUASHER_* variable below is
# still accepted, so an existing .env keeps working; SQUASHER_* wins when both are set.
SQUASHER_API_TARGET=http://127.0.0.1:8787
VITE_SQUASHER_API_URL=

# Live GitHub intake
GITHUB_TOKEN=
SQUASHER_REQUIRE_TRIGGER_LABEL=true
SQUASHER_TRIGGER_LABEL=squasher:run

# Contribution mode: how a run may write back to the issue's repository.
#   own    - only repositories GITHUB_TOKEN can push to (default)
#   fork   - repositories without push access get a fork-based pull request,
#            but only those named in SQUASHER_UPSTREAM_ALLOWLIST below
#   triage - never write to GitHub; evidence stays local
# Fork mode needs a classic PAT with public_repo: fine-grained tokens and GitHub App
# installation tokens cannot create forks.
SQUASHER_CONTRIBUTION_MODE=own

# Repositories eligible for a fork-based pull request, comma separated as owner/repo.
# Empty means no foreign repository is eligible, whatever SQUASHER_CONTRIBUTION_MODE says.
# Before adding one, read its CONTRIBUTING.md: Squasher also scans for an explicit refusal of
# automated contributions and blocks the write, but that scan is a keyword check and a clean
# result is not evidence that the project welcomes machine-generated pull requests.
SQUASHER_UPSTREAM_ALLOWLIST=

# How many of your Squasher pull requests may be open on one upstream repository at once.
# The default of 1 is a courtesy rather than a correctness rule: these pull requests are
# unsolicited, and several landing on one maintainer at once is how contributors get blocked.
# Raise it where that does not apply -- a repository you own, or a maintainer who asked for
# more. A run blocked by this limit still gathers and stores its evidence; it just does not
# write. Anything other than a positive whole number falls back to 1.
SQUASHER_MAX_OPEN_PULL_REQUESTS=1

# Model (OpenAI-compatible; point DEEPSEEK_BASE_URL elsewhere to switch providers)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=deepseek

# Sandbox execution
E2B_API_KEY=

# Optional: standalone GitHub MCP endpoint at /mcp (not used by the harness,
# which calls the GitHub tool logic in-process)
MCP_AUTH_TOKEN=
